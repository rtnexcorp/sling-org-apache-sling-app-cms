package org.apache.sling.cms.core.models;

import javax.annotation.PostConstruct;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

import org.apache.commons.lang3.StringUtils;
import org.apache.sling.api.SlingHttpServletRequest;
import org.apache.sling.api.resource.Resource;
import org.apache.sling.cms.TaxonomyItem;
import org.apache.sling.cms.TaxonomyService;
import org.apache.sling.models.annotations.DefaultInjectionStrategy;
import org.apache.sling.models.annotations.Model;
import org.apache.sling.models.annotations.injectorspecific.OSGiService;
import org.apache.sling.models.annotations.injectorspecific.Self;
import org.apache.sling.models.annotations.injectorspecific.ValueMapValue;

/**
 * Sling Model for the flexible content filter component.
 * Supports multiple filter types: content, workflow, and custom filters.
 * Configuration is done via component properties.
 */
@Model(
        adaptables = {SlingHttpServletRequest.class, Resource.class},
        defaultInjectionStrategy = DefaultInjectionStrategy.OPTIONAL)
public class ContentFilter {

    private static final String MODE_WORKFLOW = "workflow";
    private static final String MODE_CUSTOM = "custom";
    private static final String MODE_CONTENT = "content";
    private static final String MODE_ASSETS = "assets";
    private static final String MODE_SITES = "sites";

    @Self
    private SlingHttpServletRequest request;

    @Self
    private Resource resource;

    @OSGiService
    private TaxonomyService taxonomyService;

    @ValueMapValue
    private String filterMode;

    @ValueMapValue
    private String[] customFilters;

    private List<TaxonomyItem> taxonomyOptions;
    private List<FilterConfig> filterConfigs;

    @PostConstruct
    protected void init() {
        // Try to get filterMode from resource ValueMap if not set
        if (StringUtils.isEmpty(filterMode) && resource != null) {
            filterMode = resource.getValueMap().get("filterMode", String.class);
        }
        // Try to get filterMode from request attribute if not set from ValueMap
        if (StringUtils.isEmpty(filterMode) && request != null) {
            Object filterModeAttr = request.getAttribute("filterMode");
            if (filterModeAttr instanceof String) {
                filterMode = (String) filterModeAttr;
            }
        }
        // Fallback to request parameter if still not set
        if (StringUtils.isEmpty(filterMode) && request != null) {
            filterMode = request.getParameter("filterMode");
        }
        // Initialize taxonomy options for content and sites mode
        if (taxonomyService != null
                && request != null
                && !MODE_WORKFLOW.equals(filterMode)
                && !MODE_ASSETS.equals(filterMode)) {
            taxonomyOptions = taxonomyService.getAllTaxonomyItems(request.getResourceResolver());
        } else {
            taxonomyOptions = Collections.emptyList();
        }

        // Initialize filter configurations
        filterConfigs = new ArrayList<>();

        // Add filters based on mode
        if (MODE_WORKFLOW.equals(filterMode)) {
            initWorkflowFilters();
        } else if (MODE_ASSETS.equals(filterMode)) {
            initAssetFilters();
        } else if (MODE_SITES.equals(filterMode)) {
            initSitesFilters();
        } else if (MODE_CUSTOM.equals(filterMode) && customFilters != null) {
            initCustomFilters();
        } else {
            initContentFilters();
        }
    }

    private void initContentFilters() {
        filterConfigs.add(new FilterConfig("content-type-filter", "Filter by Type", "filter", new FilterOption[] {
            new FilterOption("", "All Types"),
            new FilterOption("image/", "Images"),
            new FilterOption("video/", "Videos"),
            new FilterOption("application/pdf,application/msword,application/vnd", "Documents"),
            new FilterOption("folder", "Folders")
        }));
    }

    private void initWorkflowFilters() {
        filterConfigs.add(new FilterConfig(
                "filter-process-type",
                "Filter by Process",
                "filter",
                "process-type",
                new FilterOption[] {new FilterOption("", "All Processes")},
                true // dynamic options loaded from backend
                ));

        filterConfigs.add(new FilterConfig(
                "filter-status",
                "Filter by Status",
                "check",
                "status",
                new FilterOption[] {
                    new FilterOption("", "All Status"),
                    new FilterOption("active", "Active"),
                    new FilterOption("suspended", "Suspended")
                },
                false));

        filterConfigs.add(new FilterConfig(
                "filter-assignee",
                "Filter by Assignee",
                "user",
                "assignee",
                new FilterOption[] {
                    new FilterOption("", "All Users"),
                    new FilterOption("me", "My Tasks"),
                    new FilterOption("unassigned", "Unassigned")
                },
                false));
    }

    private void initAssetFilters() {
        // Asset type filter
        filterConfigs.add(new FilterConfig(
                "filter-asset-type",
                "Filter by Type",
                "filter",
                "asset-type",
                new FilterOption[] {
                    new FilterOption("", "All Assets"),
                    new FilterOption("image/", "Images"),
                    new FilterOption("video/", "Videos"),
                    new FilterOption("audio/", "Audio"),
                    new FilterOption("application/pdf", "PDF Documents"),
                    new FilterOption("application/msword,application/vnd.openxmlformats", "Office Documents")
                },
                false));

        // Asset size filter
        filterConfigs.add(new FilterConfig(
                "filter-asset-size",
                "Filter by Size",
                "database",
                "asset-size",
                new FilterOption[] {
                    new FilterOption("", "All Sizes"),
                    new FilterOption("0-100", "< 100 KB"),
                    new FilterOption("100-1024", "100 KB - 1 MB"),
                    new FilterOption("1024-10240", "1 MB - 10 MB"),
                    new FilterOption("10240-", "> 10 MB")
                },
                false));

        // Asset modified date filter
        filterConfigs.add(new FilterConfig(
                "filter-modified",
                "Modified Date",
                "calendar",
                "modified-date",
                new FilterOption[] {
                    new FilterOption("", "Any Time"),
                    new FilterOption("today", "Today"),
                    new FilterOption("week", "This Week"),
                    new FilterOption("month", "This Month"),
                    new FilterOption("year", "This Year")
                },
                false));
    }

    private void initSitesFilters() {
        // Page status filter
        filterConfigs.add(new FilterConfig(
                "filter-page-status",
                "Page Status",
                "check",
                "page-status",
                new FilterOption[] {
                    new FilterOption("", "All Pages"),
                    new FilterOption("published", "Published"),
                    new FilterOption("draft", "Draft"),
                    new FilterOption("scheduled", "Scheduled")
                },
                false));

        // Template filter
        filterConfigs.add(new FilterConfig(
                "filter-template",
                "Filter by Template",
                "document",
                "template",
                new FilterOption[] {new FilterOption("", "All Templates")},
                true // dynamic options loaded from available templates
                ));

        // Modified date filter
        filterConfigs.add(new FilterConfig(
                "filter-modified",
                "Modified Date",
                "calendar",
                "modified-date",
                new FilterOption[] {
                    new FilterOption("", "Any Time"),
                    new FilterOption("today", "Today"),
                    new FilterOption("week", "This Week"),
                    new FilterOption("month", "This Month"),
                    new FilterOption("year", "This Year")
                },
                false));
    }

    private void initCustomFilters() {
        // Parse custom filter configurations
        // Format: "filterId:label:icon:dataAttr:option1=value1,option2=value2"
        for (String config : customFilters) {
            String[] parts = config.split(":");
            if (parts.length >= 4) {
                String filterId = parts[0];
                String label = parts[1];
                String icon = parts[2];
                String dataAttr = parts[3];

                List<FilterOption> options = new ArrayList<>();
                if (parts.length > 4) {
                    String[] optionPairs = parts[4].split(",");
                    for (String pair : optionPairs) {
                        String[] optionParts = pair.split("=");
                        if (optionParts.length == 2) {
                            options.add(new FilterOption(optionParts[0], optionParts[1]));
                        }
                    }
                }

                filterConfigs.add(
                        new FilterConfig(filterId, label, icon, dataAttr, options.toArray(new FilterOption[0]), false));
            }
        }
    }

    /**
     * Gets the filter mode configuration.
     *
     * @return filter mode (content, assets, sites, workflow, custom), defaults to "content" if not set
     */
    public String getFilterMode() {
        return StringUtils.defaultIfBlank(filterMode, MODE_CONTENT);
    }

    /**
     * Gets the list of configured filters.
     *
     * @return unmodifiable list of filter configurations
     */
    public List<FilterConfig> getFilterConfigs() {
        return filterConfigs != null ? Collections.unmodifiableList(filterConfigs) : Collections.emptyList();
    }

    /**
     * Gets the list of available taxonomy items for filtering.
     *
     * @return unmodifiable list of taxonomy options
     */
    public List<TaxonomyItem> getTaxonomyOptions() {
        return taxonomyOptions != null ? Collections.unmodifiableList(taxonomyOptions) : Collections.emptyList();
    }

    /**
     * @return true if taxonomy options are available
     */
    public boolean hasTaxonomyOptions() {
        return taxonomyOptions != null && !taxonomyOptions.isEmpty();
    }

    /**
     * Checks if workflow mode is active.
     *
     * @return true if in workflow mode
     */
    public boolean isWorkflowMode() {
        return MODE_WORKFLOW.equals(filterMode);
    }

    /**
     * Checks if assets mode is active.
     *
     * @return true if in assets mode
     */
    public boolean isAssetsMode() {
        return MODE_ASSETS.equals(filterMode);
    }

    /**
     * Checks if sites mode is active.
     *
     * @return true if in sites mode
     */
    public boolean isSitesMode() {
        return MODE_SITES.equals(filterMode);
    }

    /**
     * Checks if content mode is active.
     *
     * @return true if in content mode (default)
     */
    public boolean isContentMode() {
        return filterMode == null || MODE_CONTENT.equals(filterMode);
    }

    /**
     * Filter configuration class
     */
    public static class FilterConfig {
        private final String id;
        private final String label;
        private final String icon;
        private final String dataAttribute;
        private final FilterOption[] options;
        private final boolean dynamicOptions;

        public FilterConfig(String id, String label, String icon, FilterOption[] options) {
            this(id, label, icon, null, options, false);
        }

        public FilterConfig(
                String id,
                String label,
                String icon,
                String dataAttribute,
                FilterOption[] options,
                boolean dynamicOptions) {
            this.id = id;
            this.label = label;
            this.icon = icon;
            this.dataAttribute = dataAttribute;
            this.options = options;
            this.dynamicOptions = dynamicOptions;
        }

        public String getId() {
            return id;
        }

        public String getLabel() {
            return label;
        }

        public String getIcon() {
            return icon;
        }

        public String getDataAttribute() {
            return dataAttribute;
        }

        public FilterOption[] getOptions() {
            return options;
        }

        public boolean isDynamicOptions() {
            return dynamicOptions;
        }
    }

    /**
     * Filter option class
     */
    public static class FilterOption {
        private final String value;
        private final String label;

        public FilterOption(String value, String label) {
            this.value = value;
            this.label = label;
        }

        public String getValue() {
            return value;
        }

        public String getLabel() {
            return label;
        }
    }
}
