{
  "name": "sling-cms-it",
  "version": "1.0.0",
  "description": "Integration tests for Apache Sling CMS",
  "main": "tests/index.js",
  "scripts": {
    "cypress:install": "./node_modules/.bin/cypress install --force",
    "cypress": "./node_modules/.bin/cypress open",
    "test": "./node_modules/.bin/cypress run",
    "wait-for-ready": "node cypress/ready.js",
    "ci": "npm run cypress:install && npm run wait-for-ready && npm run test"
  },
  "author": "Apache Software Foundation",
  "license": "Apache-2.0",
  "devDependencies": {
    "chai": "^4.5.0"
  },
  "dependencies": {
    "@cypress-audit/pa11y": "^1.4.2",
    "cypress": "^15.7.1",
    "uuid": "^11.1.0"
  },
  "overrides": {
    "semver": "^7.7.3",
    "glob": "^11.0.3",
    "rimraf": "^6.0.1",
    "puppeteer": "^24.15.0"
  }
}
