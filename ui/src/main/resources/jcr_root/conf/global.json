        "width": 768,
        "height": 0,
        "format": "webp",
        "fallbackFormats": ["jpg"],
        "quality": 80,
        "cropMode": "none",
        "keepAspectRatio": true,
        "enabled": true,
        "categories": ["responsive"]
      },
      "responsive-large": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "sling/thumbnails/deliverypreset",
        "jcr:title": "Responsive Large",
        "jcr:description": "Large screen responsive images (desktop)",
        "width": 1200,
        "height": 0,
        "format": "webp",
        "fallbackFormats": ["jpg"],
        "quality": 82,
        "cropMode": "none",
        "keepAspectRatio": true,
