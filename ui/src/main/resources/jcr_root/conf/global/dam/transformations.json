  "auto-rotate-thumbnail": {
    "jcr:primaryType": "nt:unstructured",
    "name": "auto-rotate-thumbnail",
    "jcr:title": "Auto-Rotate Thumbnail",
    "jcr:description": "Automatically corrects image orientation using EXIF metadata before cropping",
    "sling:resourceType": "sling/thumbnails/transformation",
    "handlers": {
      "jcr:primaryType": "nt:unstructured",
      "autorotate": {
        "jcr:primaryType": "nt:unstructured",
