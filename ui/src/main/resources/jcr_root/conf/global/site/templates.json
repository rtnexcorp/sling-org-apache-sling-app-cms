        "label": "Name",
        "sling:resourceType": "sling-cms/components/editor/fields/text"
      }
    },
    "policies": {
      "jcr:primaryType": "nt:unstructured",
      "policymapping": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "sling-cms/components/caconfig/policymapping",
        "pathPattern": ".*",
        "policyPath": "/conf/global/site/policies/bootstrap"
      }
    }
  }
