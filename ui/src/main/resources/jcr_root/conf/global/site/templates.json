        "name": "title",
        "type": "text",
        "label": "Title",
        "sling:resourceType": "sling-cms/components/editor/fields/text"
      },
      "text_1147023191": {
        "jcr:primaryType": "nt:unstructured",
        "required": true,
        "name": ":name",
