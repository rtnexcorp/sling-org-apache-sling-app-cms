{
	"jcr:primaryType": "nt:unstructured",
	"sling:resourceType": "sling-cms/components/editor/slingform",
	"button": "Save Field",
	"fields": {
		"jcr:primaryType": "nt:unstructured",
		"sling:resourceType": "sling-cms/components/general/container",
		"label": {
			"jcr:primaryType": "nt:unstructured",
			"sling:resourceType": "sling-cms/components/editor/fields/text",
			"label": "Label",
			"name": "label",
			"required": true
		},
		"name": {
			"jcr:primaryType": "nt:unstructured",
			"sling:resourceType": "sling-cms/components/editor/fields/text",
			"label": "Name",
			"name": "name",
			"required": true
		},
		"basePath": {
			"jcr:primaryType": "nt:unstructured",
			"sling:resourceType": "sling-cms/components/editor/fields/text",
			"label": "Taxonomy Base Path",
			"name": "basePath",
			"help": "Base path for taxonomy items (e.g., /content/taxonomies). If empty, uses site settings.",
			"required": false
		},
		"placeholder": {
			"jcr:primaryType": "nt:unstructured",
			"sling:resourceType": "sling-cms/components/editor/fields/text",
			"label": "Placeholder Text",
			"name": "placeholder",
			"defaultValue": "Select taxonomy...",
			"required": false
		},
		"aiSuggestionType": {
			"jcr:primaryType": "nt:unstructured",
			"sling:resourceType": "sling-cms/components/editor/fields/select",
			"label": "AI Suggestion Type",
			"name": "aiSuggestionType",
			"help": "Enable AI-powered taxonomy suggestions",
			"options": {
				"none": {
					"jcr:primaryType": "nt:unstructured",
					"label": "Disabled",
					"value": ""
				},
				"content": {
					"jcr:primaryType": "nt:unstructured",
					"label": "Content-based",
					"value": "content-taxonomy"
				},
				"semantic": {
					"jcr:primaryType": "nt:unstructured",
					"label": "Semantic Analysis",
					"value": "semantic-taxonomy"
				},
				"context": {
					"jcr:primaryType": "nt:unstructured",
					"label": "Context-aware",
					"value": "context-taxonomy"
				}
			}
		},
		"contentSource": {
			"jcr:primaryType": "nt:unstructured",
			"sling:resourceType": "sling-cms/components/editor/fields/text",
			"label": "Content Source Field",
			"name": "contentSource",
			"help": "Field name to analyze for AI suggestions (e.g., 'jcr:title', 'jcr:description')",
			"required": false
		},
		"required": {
			"jcr:primaryType": "nt:unstructured",
			"sling:resourceType": "sling-cms/components/editor/fields/boolean",
			"label": "Required",
			"name": "required"
		},
		"help": {
			"jcr:primaryType": "nt:unstructured",
			"sling:resourceType": "sling-cms/components/editor/fields/textarea",
			"label": "Help Text",
			"name": "help",
			"rows": 2,
			"required": false
		}
	}
}
