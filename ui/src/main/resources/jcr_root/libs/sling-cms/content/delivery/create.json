{
    "jcr:primaryType": "sling:Page",
    "jcr:content": {
        "sling:resourceType": "sling-cms/components/pages/modal",
        "jcr:title": "Add Delivery Preset",
        "modalText": "Create Delivery Preset",
        "jcr:primaryType": "nt:unstructured",
        "container": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "sling-cms/components/general/container",
            "slingform": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/editor/slingform",
                "actionSuffix": "/delivery-presets/",
                "button": "Create Preset",
                "fields": {
                    "jcr:primaryType": "nt:unstructured",
                    "sling:resourceType": "sling-cms/components/general/container",
                    "basicfields": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/fieldset",
                        "legend": "Basic Information",
                        "fields": {
                            "jcr:primaryType": "nt:unstructured",
                            "sling:resourceType": "sling-cms/components/general/container",
                            "presetName": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/text",
                                "label": "Preset Name",
                                "name": ":name",
                                "required": true,
                                "description": "URL-safe identifier (e.g., hero-banner, card-thumb)"
                            },
                            "title": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/text",
                                "label": "Title",
                                "name": "jcr:title",
                                "required": true,
                                "description": "Human-readable title for display"
                            },
                            "description": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/textarea",
                                "label": "Description",
                                "name": "jcr:description",
                                "description": "Optional description of the preset's intended use"
                            },
                            "enabled": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/switch",
                                "label": "Enabled",
                                "name": "enabled",
                                "defaultChecked": true
                            }
                        }
                    },
                    "sizefields": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/fieldset",
                        "legend": "Size Settings",
                        "fields": {
                            "jcr:primaryType": "nt:unstructured",
                            "sling:resourceType": "sling-cms/components/general/container",
                            "width": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/text",
                                "label": "Width (px)",
                                "name": "width",
                                "type": "number",
                                "description": "Target width in pixels (0 for auto)"
                            },
                            "height": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/text",
                                "label": "Height (px)",
                                "name": "height",
                                "type": "number",
                                "description": "Target height in pixels (0 for auto)"
                            },
                            "keepAspectRatio": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/switch",
                                "label": "Keep Aspect Ratio",
                                "name": "keepAspectRatio",
                                "defaultChecked": true
                            }
                        }
                    },
                    "formatfields": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/fieldset",
                        "legend": "Format Settings",
                        "fields": {
                            "jcr:primaryType": "nt:unstructured",
                            "sling:resourceType": "sling-cms/components/general/container",
                            "format": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/select",
                                "label": "Output Format",
                                "name": "format",
                                "required": true,
                                "options": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "webp": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "WebP (Modern, recommended)",
                                        "value": "webp"
                                    },
                                    "avif": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "AVIF (Best compression)",
                                        "value": "avif"
                                    },
                                    "jpg": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "JPEG (Universal)",
                                        "value": "jpg"
                                    },
                                    "png": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "PNG (Lossless/Transparency)",
                                        "value": "png"
                                    }
                                }
                            },
                            "fallbackFormats": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/select",
                                "label": "Fallback Formats",
                                "name": "fallbackFormats",
                                "multiple": true,
                                "description": "Formats to use if primary format is not supported",
                                "options": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "jpg": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "JPEG",
                                        "value": "jpg"
                                    },
                                    "png": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "PNG",
                                        "value": "png"
                                    },
                                    "webp": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "WebP",
                                        "value": "webp"
                                    }
                                }
                            },
                            "quality": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/text",
                                "label": "Quality (1-100)",
                                "name": "quality",
                                "type": "number",
                                "value": "80",
                                "description": "Higher = better quality, larger file"
                            }
                        }
                    },
                    "cropfields": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/fieldset",
                        "legend": "Crop Settings",
                        "fields": {
                            "jcr:primaryType": "nt:unstructured",
                            "sling:resourceType": "sling-cms/components/general/container",
                            "cropMode": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/select",
                                "label": "Crop Mode",
                                "name": "cropMode",
                                "options": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "none": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "None (scale only)",
                                        "value": "none"
                                    },
                                    "center": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "Center",
                                        "value": "center"
                                    },
                                    "smart": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "Smart (content-aware)",
                                        "value": "smart"
                                    },
                                    "face": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "Face (focus on faces)",
                                        "value": "face"
                                    },
                                    "top": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "Top",
                                        "value": "top"
                                    },
                                    "bottom": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "label": "Bottom",
                                        "value": "bottom"
                                    }
                                }
                            }
                        }
                    },
                    "advancedfields": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/fieldset",
                        "legend": "Advanced Settings",
                        "fields": {
                            "jcr:primaryType": "nt:unstructured",
                            "sling:resourceType": "sling-cms/components/general/container",
                            "transformationName": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/text",
                                "label": "Transformation Name",
                                "name": "transformationName",
                                "description": "Use an existing transformation (optional, leave empty for dynamic)"
                            },
                            "categories": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/text",
                                "label": "Categories",
                                "name": "categories",
                                "description": "Comma-separated categories for organization"
                            }
                        }
                    },
                    "primaryType": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/hidden",
                        "name": "jcr:primaryType",
                        "value": "nt:unstructured"
                    },
                    "resourceType": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/hidden",
                        "name": "sling:resourceType",
                        "value": "sling/thumbnails/deliverypreset"
                    }
                }
            }
        }
    }
}
