{
    "jcr:primaryType": "sling:Page",
    "jcr:content": {
        "sling:resourceType": "sling-cms/components/pages/base",
        "jcr:title": "Page Edit Bar Actions",
        "jcr:primaryType": "nt:unstructured",
        "container": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "sling-cms/components/general/container",
            "richtext": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/general/textelement",
                "i18n": true,
                "level": "h3",
                "text": "Page Edit Bar Actions"
            },
            "description": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/general/textelement",
                "i18n": true,
                "level": "p",
                "text": "Configure action buttons displayed in the page edit bar. These actions appear when editing pages and allow quick access to common page management tasks."
            },
            "contentactions": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/cms/contentactions",
                "actions": {
                    "jcr:primaryType": "nt:unstructured",
                    "action": {
                        "jcr:primaryType": "nt:unstructured",
                        "label": "Action",
                        "prefix": "/cms/config/actions/pageeditbar/action/create.html"
                    }
                }
            },
            "contenttable": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/cms/contenttable",
                "columns": {
                    "jcr:primaryType": "nt:unstructured",
                    "name": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Name"
                    },
                    "title": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Title"
                    },
                    "icon": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Icon"
                    },
                    "type": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Type"
                    },
                    "prefix": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "URL Prefix"
                    },
                    "actions": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Actions"
                    }
                },
                "types": {
                    "jcr:primaryType": "nt:unstructured",
                    "nt:unstructured": {
                        "jcr:primaryType": "nt:unstructured",
                        "columns": {
                            "jcr:primaryType": "nt:unstructured",
                            "name": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/name",
                                "link": false
                            },
                            "title": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/text",
                                "property": "title"
                            },
                            "icon": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/text",
                                "property": "icon"
                            },
                            "type": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/text",
                                "property": "sling:resourceType"
                            },
                            "prefix": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/text",
                                "property": "prefix"
                            },
                            "actions": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/actions",
                                "edit": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/actions/modal",
                                    "title": "Edit Action",
                                    "icon": "pencil-f",
                                    "prefix": "/cms/config/actions/pageeditbar/action/edit.html"
                                },
                                "delete": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/actions/modal",
                                    "title": "Delete Action",
                                    "icon": "trash",
                                    "prefix": "/cms/shared/delete.html"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
