{
    "jcr:primaryType": "sling:Page",
    "jcr:content": {
        "sling:resourceType": "sling-cms/components/pages/base",
        "jcr:title": "Edit Content Schema",
        "jcr:primaryType": "nt:unstructured",
        "container": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "sling-cms/components/general/container",
            "contentbreadcrumb": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/cms/contentbreadcrumb",
                "depth": 4
            },
            "slingform": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/editor/slingform",
                "button": "Save Schema",
                "fields": {
                    "jcr:primaryType": "nt:unstructured",
                    "sling:resourceType": "sling-cms/components/general/container",
                    "title": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Title",
                        "name": "jcr:title",
                        "required": true
                    },
                    "description": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/textarea",
                        "label": "Description",
                        "name": "jcr:description"
                    },
                    "version": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Version",
                        "name": "version",
                        "required": true
                    },
                    "enabled": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/boolean",
                        "label": "Enabled",
                        "name": "enabled"
                    }
                }
            },
            "fieldsSection": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/general/container",
                "heading": {
                    "jcr:primaryType": "nt:unstructured",
                    "sling:resourceType": "sling-cms/components/general/textelement",
                    "level": "h2",
                    "text": "Schema Fields"
                },
                "contentactions": {
                    "jcr:primaryType": "nt:unstructured",
                    "sling:resourceType": "sling-cms/components/cms/contentactions",
                    "suffix": "/fields",
                    "actions": {
                        "field": {
                            "jcr:primaryType": "nt:unstructured",
                            "label": "Field",
                            "prefix": "/cms/schema/field/create.html"
                        }
                    }
                },
                "contenttable": {
                    "jcr:primaryType": "nt:unstructured",
                    "sling:resourceType": "sling-cms/components/cms/contenttable",
                    "path": "fields",
                    "columns": {
                        "jcr:primaryType": "nt:unstructured",
                        "name": {
                            "jcr:primaryType": "nt:unstructured",
                            "title": "Field Name"
                        },
                        "label": {
                            "jcr:primaryType": "nt:unstructured",
                            "title": "Label"
                        },
                        "type": {
                            "jcr:primaryType": "nt:unstructured",
                            "title": "Type"
                        },
                        "required": {
                            "jcr:primaryType": "nt:unstructured",
                            "title": "Required"
                        },
                        "order": {
                            "jcr:primaryType": "nt:unstructured",
                            "title": "Order"
                        },
                        "actions": {
                            "jcr:primaryType": "nt:unstructured",
                            "title": "Actions"
                        }
                    },
                    "types": {
                        "jcr:primaryType": "nt:unstructured",
                        "nt:unstructured": {
                            "jcr:primaryType": "nt:unstructured",
                            "columns": {
                                "jcr:primaryType": "nt:unstructured",
                                "name": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/columns/name",
                                    "link": false
                                },
                                "label": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/columns/text",
                                    "property": "label"
                                },
                                "type": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/columns/text",
                                    "property": "type"
                                },
                                "required": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/columns/text",
                                    "property": "required"
                                },
                                "order": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/columns/text",
                                    "property": "order"
                                },
                                "actions": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/columns/actions",
                                    "edit": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "sling:resourceType": "sling-cms/components/cms/actions/modal",
                                        "title": "Edit Field",
                                        "icon": "pencil-f",
                                        "prefix": "/cms/schema/field/edit.html"
                                    },
                                    "delete": {
                                        "jcr:primaryType": "nt:unstructured",
                                        "sling:resourceType": "sling-cms/components/cms/actions/modal",
                                        "title": "Delete Field",
                                        "icon": "trash",
                                        "prefix": "/cms/shared/delete.html"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
