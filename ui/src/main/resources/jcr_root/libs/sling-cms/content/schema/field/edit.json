{
    "jcr:primaryType": "sling:Page",
    "jcr:content": {
        "sling:resourceType": "sling-cms/components/pages/modal",
        "jcr:title": "Edit Schema Field",
        "jcr:primaryType": "nt:unstructured",
        "container": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "sling-cms/components/general/container",
            "slingform": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/editor/slingform",
                "button": "Update Field",
                "fields": {
                    "jcr:primaryType": "nt:unstructured",
                    "sling:resourceType": "sling-cms/components/general/container",
                    "label": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Label",
                        "name": "label",
                        "required": true
                    },
                    "description": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/textarea",
                        "label": "Description",
                        "name": "description"
                    },
                    "type": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/select",
                        "label": "Field Type",
                        "name": "type",
                        "required": true,
                        "options": {
                            "jcr:primaryType": "nt:unstructured",
                            "string": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "String (Short Text)",
                                "value": "string"
                            },
                            "text": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Text (Long Text)",
                                "value": "text"
                            },
                            "richtext": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Rich Text",
                                "value": "richtext"
                            },
                            "boolean": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Boolean (True/False)",
                                "value": "boolean"
                            },
                            "integer": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Integer (Whole Number)",
                                "value": "integer"
                            },
                            "decimal": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Decimal (Number with Decimals)",
                                "value": "decimal"
                            },
                            "date": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Date",
                                "value": "date"
                            },
                            "datetime": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Date/Time",
                                "value": "datetime"
                            },
                            "reference": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Reference (Link to Content)",
                                "value": "reference"
                            },
                            "tag": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Tag (Taxonomy)",
                                "value": "tag"
                            },
                            "asset": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Asset (File/Image)",
                                "value": "asset"
                            },
                            "select": {
                                "jcr:primaryType": "nt:unstructured",
                                "label": "Select (Dropdown)",
                                "value": "select"
                            }
                        }
                    },
                    "options": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/multifield",
                        "label": "Select Options",
                        "description": "Add options for the dropdown (only for Select field type)",
                        "name": "options",
                        "toggleSource": "type",
                        "toggleValue": "select",
                        "template": {
                            "jcr:primaryType": "nt:unstructured",
                            "label": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/text",
                                "label": "Label",
                                "description": "Display text",
                                "name": "label",
                                "required": true
                            },
                            "value": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/editor/fields/text",
                                "label": "Value",
                                "description": "Stored value",
                                "name": "value",
                                "required": true
                            }
                        }
                    },
                    "required": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/boolean",
                        "label": "Required",
                        "name": "required"
                    },
                    "multiple": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/boolean",
                        "label": "Multiple Values",
                        "name": "multiple"
                    },
                    "order": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Order",
                        "name": "order",
                        "type": "number"
                    },
                    "defaultValue": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Default Value",
                        "name": "defaultValue"
                    },
                    "validationHeading": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/general/textelement",
                        "level": "h3",
                        "text": "Validation Rules"
                    },
                    "minLength": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Min Length (for text fields)",
                        "name": "validation/minLength",
                        "type": "number"
                    },
                    "maxLength": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Max Length (for text fields)",
                        "name": "validation/maxLength",
                        "type": "number"
                    },
                    "min": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Min Value (for number fields)",
                        "name": "validation/min",
                        "type": "number"
                    },
                    "max": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Max Value (for number fields)",
                        "name": "validation/max",
                        "type": "number"
                    },
                    "pattern": {
                        "jcr:primaryType": "nt:unstructured",
                        "sling:resourceType": "sling-cms/components/editor/fields/text",
                        "label": "Pattern (Regular Expression)",
                        "name": "validation/pattern",
                        "description": "e.g. ^[A-Z0-9-]{5,20}$ for SKU validation"
                    }
                }
            }
        }
    }
}
