{
    "jcr:primaryType": "sling:Page",
    "jcr:content": {
        "sling:resourceType": "sling-cms/components/pages/base",
        "jcr:title": "Content Schemas",
        "jcr:primaryType": "nt:unstructured",
        "container": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "sling-cms/components/general/container",
            "contentactions": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/cms/contentactions",
                "actions": {
                    "schema": {
                        "jcr:primaryType": "nt:unstructured",
                        "label": "Content Schema",
                        "prefix": "/cms/schema/create.html"
                    }
                }
            },
            "contentbreadcrumb": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/cms/contentbreadcrumb",
                "depth": 3
            },
            "contenttable": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "sling-cms/components/cms/contenttable",
                "columns": {
                    "jcr:primaryType": "nt:unstructured",
                    "name": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Schema ID"
                    },
                    "title": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Title"
                    },
                    "description": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Description"
                    },
                    "version": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Version"
                    },
                    "actions": {
                        "jcr:primaryType": "nt:unstructured",
                        "title": "Actions"
                    }
                },
                "types": {
                    "jcr:primaryType": "nt:unstructured",
                    "nt:unstructured": {
                        "jcr:primaryType": "nt:unstructured",
                        "columns": {
                            "jcr:primaryType": "nt:unstructured",
                            "name": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/name",
                                "link": true,
                                "prefix": "/cms/schema/edit.html"
                            },
                            "title": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/text",
                                "property": "jcr:title"
                            },
                            "description": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/text",
                                "property": "jcr:description"
                            },
                            "version": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/text",
                                "property": "version"
                            },
                            "actions": {
                                "jcr:primaryType": "nt:unstructured",
                                "sling:resourceType": "sling-cms/components/cms/columns/actions",
                                "edit": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/actions/basic",
                                    "title": "Edit Schema",
                                    "icon": "pencil-f",
                                    "prefix": "/cms/schema/edit.html"
                                },
                                "delete": {
                                    "jcr:primaryType": "nt:unstructured",
                                    "sling:resourceType": "sling-cms/components/cms/actions/modal",
                                    "title": "Delete Schema",
                                    "icon": "trash",
                                    "prefix": "/cms/shared/delete.html"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
