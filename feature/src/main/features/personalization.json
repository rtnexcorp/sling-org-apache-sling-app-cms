{
  "bundles": [
    {
      "id": "org.apache.sling:org.apache.sling.cms.personalization:${cms-version}",
      "start-order": "20"
    },
    {
      "id": "org.reactivestreams:reactive-streams:1.0.3",
      "start-order": "15"
    },
    {
      "id": "com.graphql-java:java-dataloader:3.2.0",
      "start-order": "15"
    },
    {
      "id": "com.graphql-java:graphql-java:20.1",
      "start-order": "15"
    },
    {
      "id": "org.apache.johnzon:johnzon-mapper:1.2.8",
      "start-order": "15"
    },
    {
      "id": "org.apache.sling:org.apache.sling.graphql.core:0.0.20",
      "start-order": "20"
    }
  ],
  "configurations": {
    "org.apache.sling.graphql.core.GraphQLServlet~personalization": {
      "sling.servlet.resourceTypes": "personalization/servlet",
      "sling.servlet.extensions": "json",
      "sling.servlet.methods": [
        "GET",
        "POST"
      ]
    }
  },
  "repoinit:TEXT|true": [
    "# Personalization Service User Configuration",
    "",
    "# Note: No service user required - PersonalizationService does not need repository access",
    "# All segment evaluation is done in-memory based on request context",
    "",
    "# Create personalization configuration paths in /etc (persistent configuration)",
    "create path (sling:Folder) /etc/personalization",
    "create path (sling:Folder) /etc/personalization/segments",
    "",
    "# Create GraphQL schema paths for personalization",
    "create path (sling:Folder) /apps/personalization",
    "create path (sling:Folder) /apps/personalization/schemas",
    "",
    "# Create personalization variants in /content (content-managed)",
    "# Variants are stored as child nodes of components with sling:resourceType='sling:PersonalizationVariant'",
    "",
    "# Grant read access for anonymous users to segments (for client-side evaluation if needed)",
    "set ACL for anonymous",
    "  allow jcr:read on /etc/personalization",
    "end",

    "",
    "# Create /graphql mount point used by Sling GraphQL core sample patterns",
    "create path (sling:Folder) /graphql",
    "",
    "# Allow public read access to /graphql so clients can POST queries",
    "set ACL for everyone",
    "  allow jcr:read on /graphql",
    "end"
  ]
}
