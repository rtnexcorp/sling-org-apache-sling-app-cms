{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Auto Deploy - Core",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean",
                "install",
                "-P", "autoInstallBundle",
                "-pl", "core",
                "-DskipTests",
                "-Dbnd.baseline.skip=true"
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Auto Deploy - API",
