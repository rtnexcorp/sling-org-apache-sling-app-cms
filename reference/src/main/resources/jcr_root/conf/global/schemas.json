{
    "jcr:primaryType": "sling:Folder",
    "article": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "sling-cms/components/cms/schema",
        "jcr:title": "Article",
        "description": "Blog article or news post",
        "version": "1.0",
        "enabled": true,
        "fields": {
            "jcr:primaryType": "nt:unstructured",
            "title": {
                "jcr:primaryType": "nt:unstructured",
                "name": "title",
                "label": "Title",
                "type": "STRING",
                "required": true,
                "order": 10
            },
            "summary": {
                "jcr:primaryType": "nt:unstructured",
                "name": "summary",
                "label": "Summary",
                "description": "Brief summary of the article",
                "type": "TEXT",
                "required": false,
                "order": 20
            },
            "body": {
                "jcr:primaryType": "nt:unstructured",
                "name": "body",
                "label": "Body",
                "type": "RICHTEXT",
                "required": true,
                "order": 30
            },
            "author": {
                "jcr:primaryType": "nt:unstructured",
                "name": "author",
                "label": "Author",
                "type": "REFERENCE",
                "required": false,
                "order": 40
            },
            "publishDate": {
                "jcr:primaryType": "nt:unstructured",
                "name": "publishDate",
                "label": "Publish Date",
                "type": "DATE",
                "required": true,
                "order": 50
            },
            "expiryDate": {
                "jcr:primaryType": "nt:unstructured",
                "name": "expiryDate",
                "label": "Expiry Date",
                "type": "DATE",
                "required": false,
                "order": 60
            },
            "category": {
                "jcr:primaryType": "nt:unstructured",
                "name": "category",
                "label": "Category",
                "type": "SELECT",
                "required": true,
                "order": 70,
                "options": ["Technology", "Business", "Lifestyle", "News", "Opinion"]
            },
            "tags": {
                "jcr:primaryType": "nt:unstructured",
                "name": "tags",
                "label": "Tags",
                "type": "TAG",
                "required": false,
                "multiple": true,
                "order": 80
            },
            "featuredImage": {
                "jcr:primaryType": "nt:unstructured",
                "name": "featuredImage",
                "label": "Featured Image",
                "type": "ASSET",
                "required": false,
                "order": 90
            },
            "featured": {
                "jcr:primaryType": "nt:unstructured",
                "name": "featured",
                "label": "Featured Article",
                "type": "BOOLEAN",
                "required": false,
                "order": 100
            },
            "viewCount": {
                "jcr:primaryType": "nt:unstructured",
                "name": "viewCount",
                "label": "View Count",
                "type": "INTEGER",
                "required": false,
                "defaultValue": "0",
                "order": 110
            },
            "rating": {
                "jcr:primaryType": "nt:unstructured",
                "name": "rating",
                "label": "Rating",
                "type": "DECIMAL",
                "required": false,
                "min": "0",
                "max": "5",
                "order": 120
            }
        }
    },
    "product": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "sling-cms/components/cms/schema",
        "jcr:title": "Product",
        "description": "E-commerce product",
        "version": "1.0",
        "enabled": true,
        "fields": {
            "jcr:primaryType": "nt:unstructured",
            "productName": {
                "jcr:primaryType": "nt:unstructured",
                "name": "productName",
                "label": "Product Name",
                "type": "STRING",
                "required": true,
                "order": 10
            },
            "sku": {
                "jcr:primaryType": "nt:unstructured",
                "name": "sku",
                "label": "SKU",
                "description": "Product SKU/Code",
                "type": "STRING",
                "required": true,
                "order": 20
            },
            "description": {
                "jcr:primaryType": "nt:unstructured",
                "name": "description",
                "label": "Description",
                "type": "RICHTEXT",
                "required": true,
                "order": 30
            },
            "price": {
                "jcr:primaryType": "nt:unstructured",
                "name": "price",
                "label": "Price",
                "type": "DECIMAL",
                "required": true,
                "min": "0",
                "order": 40
            },
            "stockQuantity": {
                "jcr:primaryType": "nt:unstructured",
                "name": "stockQuantity",
                "label": "Stock Quantity",
                "type": "INTEGER",
                "required": true,
                "min": "0",
                "defaultValue": "0",
                "order": 50
            },
            "category": {
                "jcr:primaryType": "nt:unstructured",
                "name": "category",
                "label": "Category",
                "type": "SELECT",
                "required": true,
                "order": 60,
                "options": ["Electronics", "Clothing", "Home & Garden", "Sports", "Books", "Toys"]
            },
            "productImages": {
                "jcr:primaryType": "nt:unstructured",
                "name": "productImages",
                "label": "Product Images",
                "type": "ASSET",
                "required": false,
                "multiple": true,
                "order": 70
            },
            "featured": {
                "jcr:primaryType": "nt:unstructured",
                "name": "featured",
                "label": "Featured Product",
                "type": "BOOLEAN",
                "required": false,
                "order": 80
            }
        }
    }
}
